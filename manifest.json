{
  "manifest_version": 3,
  "name": "Shutterfly Address Book Exporter",
  "version": "1.3",
  "description": "Export your Shutterfly address book to a CSV file.",
  "permissions": ["webRequest", "downloads", "storage"],
  "host_permissions": [
    "https://accounts.shutterfly.com/*",
    "https://accounts-api3.shutterfly.com/*"
  ],
  "background": {
    "service_worker": "dist/background.bundle.js"
  },
  "content_scripts": [
    {
      "matches": ["https://accounts.shutterfly.com/account-settings*"],
      "js": ["dist/content.bundle.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
